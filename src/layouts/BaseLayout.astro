---
import '../styles/global.css';
import { getCollection } from 'astro:content';

const { title = 'கூவல் - இலக்கிய இதழ்', description = 'தமிழ்ச் சமூகத்தின் பன்மைத்துவத்தை கலை - இலக்கிய - சூழலியல் ஆளுமைகளின் நேர்காணல் மூலம் உணர ஓர் முன்னெடுப்பு' } = Astro.props;
const all = await getCollection('interviews');
const counts: Record<string, number> = {};
all.forEach((e) => e.data.tags.forEach((t) => { counts[t] = (counts[t] || 0) + 1; }));
const tags = Object.keys(counts).sort((a, b) => counts[b] - counts[a]).slice(0, 12);
---
<!doctype html>
<html lang="ta">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Baloo+Thambi+2:wght@400;600;800&family=Meera+Inimai&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="hd">
      <a class="br" href="/"><span class="lg">கூவல்</span><small>சிந்தனைக்கும் இலக்கியத்துக்கும் ஒரு அமைதியான இடம்</small></a>
      <nav>
        <a class="on" href="/">முகப்பு</a>
        <a href="/#wall">மேற்கோள்கள்</a>
        <a href="/#join">சந்தா</a>
      </nav>
      <a class="cta" href="/#join">சந்தா சேர் <svg class="i" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </header>

    <slot />

    <section class="jn" id="join">
      <div><h2>உரையாடலில் <span>இணையுங்கள்</span></h2><p>மாதாந்திர கட்டுரைகள், தனிச்சிறப்பு நேர்காணல்கள் உங்கள் இன்பாக்ஸில்.</p></div>
      <div>
        <form id="nf" data-form="newsletter" data-ok="நன்றி! உங்கள் சந்தா பதிவு செய்யப்பட்டது.">
          <input type="email" name="email" required placeholder="உங்கள் மின்னஞ்சல் முகவரி" aria-label="மின்னஞ்சல்" />
          <button aria-label="சந்தா சேர்"><svg class="i" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
        </form>
        <div id="nm" role="status"></div>
      </div>
    </section>

    <footer>
      <div class="lg">கூவல்</div>
      <p>தமிழ்ச் சமூகத்தின் பன்மைத்துவத்தை கலை - இலக்கிய - சூழலியல் ஆளுமைகளின் நேர்காணல் மூலம் உணர ஓர் முன்னெடுப்பு</p>
      {tags.length > 0 && <div class="tg">{tags.map((t) => <span>{t}</span>)}</div>}
      <small>© 2026 கூவல் இணைய இதழ்</small>
    </footer>
    <script is:inline src="/js/site.js"></script>
  </body>
</html>



