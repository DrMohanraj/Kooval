---
import { getCollection } from 'astro:content';
const all = (await getCollection('interviews')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
let quotes: any[] = [];
all.forEach((e) => e.data.pullQuotes.forEach((q) => quotes.push({ q, c: e.data.category, a: e.data.author, r: e.data.authorRole || '', s: e.slug })));
const base = quotes.slice();
while (quotes.length > 0 && quotes.length < 6) quotes = quotes.concat(base);
const TN = [0, 2, 3, 0, 2, 1];
const rows = [quotes, quotes.slice().reverse()];
---
{quotes.length > 0 && (
  <section class="wk" id="wall">
    <h2>நகரும் <span>மேற்கோள்</span> சுவர்</h2>
    {rows.map((row, ri) => (
      <div class="row">
        <div class={ri ? 'tr r' : 'tr'}>
          {[0, 1].map(() => row.map((x, i) => (
            <a href={`/interview/${x.s}`} class={`qc c${TN[(i + ri * 2) % 6]}`}>
              <span class="p">{x.c}</span>
              <i>”</i>
              <p>{x.q}</p>
              <div class="f"><b>{x.a}</b><small>{x.r}{x.r ? ' · ' : ''}முழு நேர்காணலைப் படிக்க ↗</small></div>
            </a>
          )))}
        </div>
      </div>
    ))}
  </section>
)}



