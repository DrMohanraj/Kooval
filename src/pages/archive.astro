---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

function slugify(name: string) {
  return (name || '').trim().toLowerCase().replace(/\s+/g, '-').replace(/[^\w\u0B80-\u0BFF-]/g, '');
}

const interviews = await getCollection('interviews');
const sorted = interviews.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const categories = [...new Set(sorted.map((i) => i.data.category || 'இலக்கியம்'))];
---
<BaseLayout title="காப்பகம் - கூவல் இலக்கிய இதழ்">
  <section class="px-margin-desktop pt-16 pb-8 text-center reveal active">
    <p class="font-label-caps text-xs md:text-sm text-secondary font-bold tracking-widest mb-3 uppercase">The Living Repository</p>
    <h1 class="font-display-lg text-4xl md:text-6xl text-primary font-bold mb-4">நேர்காணல் காப்பகம்</h1>
    <p class="font-body-lg text-base md:text-lg text-neutral-600 max-w-2xl mx-auto leading-relaxed">
      தமிழ் சிந்தனை, கலை, இலக்கிய மற்றும் சூழலியல் சிறப்பின் ஆழத்தை ஆராயும் ஆளுமைகளின் ஆவணத் தொகுப்பு.
    </p>
  </section>

  <section class="px-margin-desktop flex flex-wrap gap-2.5 justify-center mb-10 reveal active">
    <button class="filter-btn active bg-primary text-white px-5 py-2 rounded-full font-label-caps text-xs md:text-sm font-semibold transition-all shadow-sm" data-filter="all">அனைத்தும்</button>
    {categories.map((cat) => (
      <button class="filter-btn bg-white text-neutral-700 border border-neutral-200 px-5 py-2 rounded-full font-label-caps text-xs md:text-sm font-semibold hover:border-primary hover:text-primary transition-all" data-filter={cat}>{cat}</button>
    ))}
  </section>

  <section class="px-margin-desktop pb-section-gap">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="interview-grid">
      {sorted.length === 0 && (
        <p class="col-span-3 text-center font-body-md text-neutral-500 py-16">
          இன்னும் நேர்காணல்கள் சேர்க்கப்படவில்லை. <a href="/admin" class="text-primary underline font-bold">/admin</a> மூலம் முதல் நேர்காணலைச் சேருங்கள்.
        </p>
      )}
      {sorted.map((entry) => {
        const author = entry.data.authorName || entry.data.author || 'எழுத்தாளர்';
        const cover = entry.data.coverImage || entry.data.heroImage || entry.data.authorPhoto || (entry.data.photos && entry.data.photos[0]) || 'https://images.unsplash.com/photo-1516575334481-f85287c2c82d?w=1200&h=675&fit=crop&q=80';
        const cat = entry.data.category || 'இலக்கியம்';

        return (
          <div data-category={cat} data-tags={(entry.data.tags || []).join(',')}
               class="interview-card reveal active magazine-lift bg-white rounded-2xl overflow-hidden border border-neutral-200/80 shadow-sm hover:shadow-xl transition-all flex flex-col justify-between">
            <div>
              <a href={`/interview/${entry.slug}`} class="block aspect-[16/10] overflow-hidden relative group">
                <span class="absolute top-3 left-3 z-10 bg-primary/90 text-white font-label-caps text-xs px-3 py-1 rounded-full shadow-sm">
                  {cat}
                </span>
                <img src={cover} alt={author} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              </a>

              <div class="p-6">
                <div class="flex items-center gap-2 text-xs text-neutral-500 mb-2 font-caption">
                  <span>{entry.data.date.toLocaleDateString('ta-IN', { year: 'numeric', month: 'long' })}</span>
                  {entry.data.issueNumber && <span>• இதழ் {entry.data.issueNumber}</span>}
                </div>
                <a href={`/interview/${entry.slug}`} class="block group">
                  <h3 class="font-headline-md text-xl font-bold text-neutral-900 group-hover:text-primary transition-colors leading-snug mb-3">
                    {entry.data.title}
                  </h3>
                </a>
                <p class="font-body-md text-sm text-neutral-600 line-clamp-3 mb-4 leading-relaxed">
                  {entry.data.excerpt}
                </p>

                {entry.data.tags && entry.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 mb-4">
                    {entry.data.tags.map((tag) => (
                      <span class="font-caption text-[11px] bg-neutral-100 text-neutral-600 px-2.5 py-0.5 rounded-full">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            </div>

            <div class="px-6 pb-6 pt-2 border-t border-neutral-100 flex items-center justify-between">
              <a href={`/author/${slugify(author)}`} class="flex items-center gap-2.5 group">
                {entry.data.authorPhoto && (
                  <img src={entry.data.authorPhoto} alt={author} class="w-7 h-7 rounded-full object-cover border border-neutral-200" />
                )}
                <span class="text-xs font-semibold text-neutral-800 group-hover:text-primary transition-colors">{author}</span>
              </a>
              <a href={`/interview/${entry.slug}`} class="text-xs font-bold text-primary hover:underline flex items-center gap-1">
                வாசிக்க <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <script is:inline>
    const buttons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.interview-card');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => {
          b.classList.remove('active', 'bg-primary', 'text-white');
          b.classList.add('bg-white', 'text-neutral-700', 'border', 'border-neutral-200');
        });
        btn.classList.add('active', 'bg-primary', 'text-white');
        btn.classList.remove('bg-white', 'text-neutral-700', 'border');
        const filter = btn.getAttribute('data-filter');
        cards.forEach((card) => {
          const match = filter === 'all' || card.getAttribute('data-category') === filter;
          card.style.display = match ? '' : 'none';
        });
      });
    });

    const urlParams = new URLSearchParams(window.location.search);
    const tagFilter = urlParams.get('tag');
    if (tagFilter) {
      buttons.forEach((b) => {
        b.classList.remove('active', 'bg-primary', 'text-white');
        b.classList.add('bg-white', 'text-neutral-700', 'border');
      });
      cards.forEach((card) => {
        const cardTags = (card.getAttribute('data-tags') || '').split(',');
        card.style.display = cardTags.includes(tagFilter) ? '' : 'none';
      });
    }
  </script>
</BaseLayout>
