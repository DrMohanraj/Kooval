  <!-- Serialized interviews for reading modal -->
  <script is:inline type="application/json" id="interviews-json" set:html={serializedData}></script>

  <!-- Client-side Interactive Logic -->
  <script is:inline>
    // 1. Hero Typewriter Animation with realistic cadence
    (function initTypewriter() {
      const el = document.getElementById('typer');
      if (!el) return;
      const text = el.getAttribute('data-full') || '';
      let i = 0;
      function step() {
        if (i <= text.length) {
          el.textContent = text.slice(0, i++);
          const char = text[i - 1];
          const delay = (char === '.' || char === '!' || char === '?') ? 350 : (char === ',' ? 180 : 32);
          setTimeout(step, delay);
        }
      }
      step();
    })();

    // 2. In-Place Interview Reader Data & Handlers
    let currentInterviews = [];
    try {
      const raw = document.getElementById('interviews-json').textContent;
      currentInterviews = JSON.parse(raw);
    } catch (e) {
      console.error(e);
    }

    let baseFontSize = 16.5;

    function openReader(slug) {
      const entry = currentInterviews.find((item) => item.slug === slug) || currentInterviews[0];
      if (!entry) return;

      document.getElementById('drawerCategoryPill').textContent = entry.category;
      document.getElementById('drawerIssueText').textContent = 'இதழ் ' + (entry.issueNumber || '12') + ' • ' + entry.date;
      document.getElementById('drawerCoverImg').src = entry.coverImage;
      document.getElementById('drawerAuthorAvatar').src = entry.authorPhoto;
      document.getElementById('drawerAuthorName').textContent = entry.authorName;
      document.getElementById('drawerAuthorRole').textContent = entry.authorRole || 'எழுத்தாளர்';
      document.getElementById('drawerTitle').textContent = entry.title;

      // Pull Quote
      const quoteBox = document.getElementById('drawerPullQuoteBox');
      const quoteText = document.getElementById('drawerPullQuoteText');
      if (entry.pullQuotes && entry.pullQuotes.length > 0) {
        quoteText.textContent = entry.pullQuotes[0];
        quoteBox.style.display = 'block';
      } else {
        quoteBox.style.display = 'none';
      }

      // QA Flow
      const qaContainer = document.getElementById('drawerQAList');
      qaContainer.innerHTML = '';
      if (entry.qa && entry.qa.length > 0) {
        entry.qa.forEach((item, idx) => {
          const card = document.createElement('div');
          card.className = 'qa-card-block';
          card.innerHTML = `
            <div class="qa-q-title">
              <span class="qa-badge-q">${idx + 1}</span>
              <span>${item.question}</span>
            </div>
            <p class="qa-a-text">${item.answer}</p>
          `;
          qaContainer.appendChild(card);
        });
      } else {
        const fallback = document.createElement('div');
        fallback.className = 'qa-card-block';
        fallback.innerHTML = `<p class="qa-a-text">${entry.excerpt}</p>`;
        qaContainer.appendChild(fallback);
      }

      const drawer = document.getElementById('readerDrawer');
      drawer.classList.add('active');
      document.body.style.overflow = 'hidden';
      document.getElementById('drawerScrollArea').scrollTop = 0;
    }

    function closeReader() {
      const drawer = document.getElementById('readerDrawer');
      drawer.classList.remove('active');
      document.body.style.overflow = '';
    }

    function closeReaderOnBackdrop(e) {
      if (e.target.id === 'readerDrawer') {
        closeReader();
      }
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeReader();
    });

    function changeFontSize(delta) {
      baseFontSize = Math.max(14, Math.min(24, baseFontSize + delta * 1.5));
      const texts = document.querySelectorAll('.qa-a-text, #drawerPullQuoteText');
      texts.forEach((t) => (t.style.fontSize = baseFontSize + 'px'));
    }

    // 3. Category Filter for Editorial Showcase
    function filterShowcase(category) {
      const buttons = document.querySelectorAll('.category-filter-btn');
      buttons.forEach((b) => {
        if (b.getAttribute('data-cat') === category) {
          b.style.background = '#0F5BC0';
          b.style.color = '#FFFFFF';
          b.style.borderColor = '#0F5BC0';
        } else {
          b.style.background = '#FFFFFF';
          b.style.color = '#17191E';
          b.style.borderColor = 'rgba(23,25,30,0.12)';
        }
      });

      const cards = document.querySelectorAll('.article-card');
      cards.forEach((card) => {
        const itemCat = card.getAttribute('data-category');
        if (category === 'அனைத்தும்' || itemCat === category) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    }

    // 4. Newsletter Subscribe Mock
    function handleSubscribe(e) {
      e.preventDefault();
      const email = document.getElementById('subEmail').value;
      const msg = document.getElementById('subMessage');
      msg.textContent = 'நன்றி! ' + email + ' பதிவு செய்யப்பட்டது. அடுத்த இதழ் உங்கள் இன்பாக்ஸில் வரும்.';
      document.getElementById('subscribeForm').reset();
    }
  </script>
