---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteWall from '../components/QuoteWall.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('interviews')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const picks = [...all.filter((e) => e.data.featured), ...all.filter((e) => !e.data.featured)].slice(0, 5);
const fmt = (d: Date) => d.toLocaleDateString('ta-IN', { year: 'numeric', month: 'long' });
const THEME: Record<string, number> = { yellow: 1, blue: 2, black: 3 };

function slugify(name: string) {
  return (name || '').trim().toLowerCase().replace(/\s+/g, '-').replace(/[^\w\u0B80-\u0BFF-]/g, '');
}

const slides = picks.map((e) => ({
  slug: e.slug,
  name: e.data.authorName || e.data.author || 'எழுத்தாளர்',
  role: e.data.authorRole || '',
  date: fmt(e.data.date),
  quote: (e.data.pullQuotes && e.data.pullQuotes[0]) || '',
  desc: e.data.excerpt || '',
  spines: [e.data.category || 'இலக்கியம்', ...(e.data.tags || []).slice(0, 3), fmt(e.data.date)].slice(0, 5),
  img: e.data.coverImage || e.data.heroImage || e.data.authorPhoto || (e.data.photos && e.data.photos[0]) || 'https://images.unsplash.com/photo-1516575334481-f85287c2c82d?w=1200&h=675&fit=crop&q=80',
  cut: Boolean(e.data.heroImage),
  theme: THEME[e.data.heroTheme] || 1,
}));
const s0 = slides[0];
const json = JSON.stringify(slides).replace(/</g, '\\u003c');
const recentInterviews = all.slice(0, 6);
---
<BaseLayout>
  {s0 ? (
    <section class:list={['hero', { photo: !s0.cut }]} data-s={s0.theme} id="top">
      <div class="hl" id="hl">
        <span class="kk">இந்த இதழ்</span>
        <h2 class="t">இந்த இதழின் எழுத்தாளர்</h2>
        <h1 class="nm" id="nm1"><span>{s0.name}</span></h1>
        <div class="rl" id="rl">{s0.role}{s0.role ? ' · ' : ''}{s0.date}</div>
        <p class="qt" id="qt">{s0.quote ? `“ ${s0.quote} ”` : ''}</p>
        <p class="ds" id="ds">{s0.desc}</p>
        <a class="bt" id="bt" href={`/interview/${s0.slug}`}>நேர்காணலைப் படிக்க <svg class="i" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      </div>
      <div class="art">
        <div class="dsc" id="dsc"><div class="ph"><img id="phi" src={s0.img} alt={s0.name} /></div></div>
        <div class="ht"></div>
        <div class="hw" id="hw">{slides.map((s) => s.quote).filter(Boolean).join(' ')}</div>
        <Fragment set:html={`<svg class="sk" viewBox="0 0 1000 280" preserveAspectRatio="xMidYMax slice"><defs><pattern id="wn" width="16" height="22" patternUnits="userSpaceOnUse"><rect x="4" y="5" width="7" height="10" style="fill:var(--win)"/></pattern></defs>
<g fill="currentColor"><path id="bl" d="M0 280V170h70v-34h54v48h46v-70h76v90h54v-44h66v74h44v-96h84v116h62v-54h74v64h54v-130h96v150h62v-86h66v96h92V280z"/><rect x="0" y="262" width="1000" height="18"/></g><use href="#bl" fill="url(#wn)" opacity=".85"/>
<g fill="currentColor"><circle cx="150" cy="128" r="40"/><circle cx="185" cy="140" r="30"/><circle cx="120" cy="150" r="28"/><rect x="146" y="150" width="8" height="120"/><circle cx="820" cy="120" r="46"/><circle cx="860" cy="138" r="32"/><circle cx="785" cy="140" r="30"/><rect x="816" y="150" width="9" height="120"/></g>
<g stroke="currentColor" stroke-width="7" fill="none" stroke-linecap="round"><path d="M560 270Q568 190 555 120"/><path d="M555 120q-40-6-62 22M555 120q36-14 66 8M555 120q-16-34-46-40M555 120q18-38 52-34M555 120q-4-30 4-52"/></g>
<g stroke="currentColor" stroke-width="5" fill="none"><path d="M690 272V90"/></g><g fill="currentColor"><path d="M676 86h28l-5-28h-18z"/></g><circle cx="690" cy="72" r="7" style="fill:var(--win)"/><g stroke="currentColor" stroke-width="3" fill="none"><path d="M690 56V44"/><path d="M60 40q8-10 16 0q8-10 16 0M110 70q7-9 14 0q7-9 14 0M300 30q8-10 16 0q8-10 16 0M930 60q7-9 14 0q7-9 14 0"/></g></svg>`} />
        <div class="pt" id="pt"><img id="pti" src={s0.img} alt={s0.name} /></div>
        <div class="bks" id="bks">{s0.spines.map((t) => <b>{t}</b>)}</div>
        <div class="ctl" id="ctl" hidden={slides.length < 2}>
          <span class="c"><b id="cn">01</b> / <span id="ct">{String(slides.length).padStart(2, '0')}</span></span>
          <button id="pv" aria-label="முந்தையது"><svg class="i" viewBox="0 0 24 24"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></button>
          <button id="nx" aria-label="அடுத்தது"><svg class="i" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
        </div>
      </div>
      <script is:inline type="application/json" id="slides" set:html={json}></script>
    </section>
  ) : (
    <section class="hero" data-s="1" style="min-height:360px">
      <div class="hl"><h2 class="t">இன்னும் நேர்காணல்கள் இல்லை</h2><p class="ds">/admin வழியாக முதல் நேர்காணலைச் சேர்க்கவும்.</p></div>
    </section>
  )}

  <!-- Featured Editorial Section -->
  <section class="px-margin-desktop py-section-gap">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-stack-lg gap-4 reveal">
        <div>
          <span class="font-label-caps text-label-caps text-secondary font-bold tracking-widest block mb-2">CURATED VOICES</span>
          <h2 class="font-display-lg text-3xl md:text-5xl text-primary font-bold">சமீபத்திய நேர்காணல்கள்</h2>
        </div>
        <a href="/archive" class="inline-flex items-center gap-2 font-label-caps text-sm text-primary font-semibold hover:text-secondary transition-colors group">
          அனைத்து நேர்காணல்களும் (காப்பகம்)
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {recentInterviews.map((entry) => {
          const author = entry.data.authorName || entry.data.author || 'எழுத்தாளர்';
          const cover = entry.data.coverImage || entry.data.heroImage || entry.data.authorPhoto || (entry.data.photos && entry.data.photos[0]) || 'https://images.unsplash.com/photo-1516575334481-f85287c2c82d?w=1200&h=675&fit=crop&q=80';
          return (
            <article class="reveal magazine-lift bg-white rounded-2xl overflow-hidden border border-neutral-200/80 shadow-sm hover:shadow-xl transition-all flex flex-col justify-between">
              <div>
                <a href={`/interview/${entry.slug}`} class="block aspect-[16/10] overflow-hidden relative group">
                  <span class="absolute top-3 left-3 z-10 bg-primary/90 text-white font-label-caps text-xs px-3 py-1 rounded-full shadow-sm">
                    {entry.data.category || 'இலக்கியம்'}
                  </span>
                  <img src={cover} alt={author} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                </a>

                <div class="p-6">
                  <div class="flex items-center gap-2 text-xs text-neutral-500 mb-2 font-caption">
                    <span>{entry.data.date.toLocaleDateString('ta-IN', { year: 'numeric', month: 'long' })}</span>
                    {entry.data.issueNumber && <span>• இதழ் {entry.data.issueNumber}</span>}
                  </div>
                  <a href={`/interview/${entry.slug}`} class="block group">
                    <h3 class="font-headline-md text-xl font-bold text-neutral-900 group-hover:text-primary transition-colors leading-snug mb-3">
                      {entry.data.title}
                    </h3>
                  </a>
                  <p class="font-body-md text-sm text-neutral-600 line-clamp-3 mb-4 leading-relaxed">
                    {entry.data.excerpt}
                  </p>
                </div>
              </div>

              <div class="px-6 pb-6 pt-2 border-t border-neutral-100 flex items-center justify-between">
                <a href={`/author/${slugify(author)}`} class="flex items-center gap-2.5 group">
                  {entry.data.authorPhoto && (
                    <img src={entry.data.authorPhoto} alt={author} class="w-7 h-7 rounded-full object-cover border border-neutral-200" />
                  )}
                  <span class="text-xs font-semibold text-neutral-800 group-hover:text-primary transition-colors">{author}</span>
                </a>
                <a href={`/interview/${entry.slug}`} class="text-xs font-bold text-primary hover:underline flex items-center gap-1">
                  வாசிக்க <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <QuoteWall />
</BaseLayout>
